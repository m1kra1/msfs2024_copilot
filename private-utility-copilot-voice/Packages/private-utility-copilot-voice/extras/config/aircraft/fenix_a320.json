{
  "profile_id": "fenix_a320",
  "title": "Fenix A320 family (SimConnect events + Unable for unmapped FCU)",
  "extends": "generic",
  "notes": "Fenix-oriented profile for Private Voice Co-Pilot. Gear lever is L:S_MIP_GEAR (0=UP, 1=DOWN) from Fenix Cockpit_Behavior.xml — profile sends GEAR_UP/DOWN plus set_simvar on that LVar (no third-party bridge). Positive-rate callouts use Airbus phraseology. Landing/exterior light switches use S_OH_EXT_LT_* LVars (3-pos). Unmapped FCU modes return Unable TTS. Live Free Flight verification recommended.",
  "limitations": [
    "Select fenix_a320 via settings, GUI, or auto-detect (TITLE contains 'fenix').",
    "LVar writes use SimConnect SetDataOnSimObject (L: name). If a future Fenix build ignores external LVar sets, cockpit switches may not animate even when systems respond to events.",
    "Airbus FCU mode engages (HDG/ALT/SPD/VS hold, NAV, APP, LOC) are overridden to Unable.",
    "FCU bug/var knobs (heading/alt/spd/vs inc/dec) keep standard events best-effort.",
    "Anti-ice, APU, cabin/wing/logo lights remain base mappings unless overridden.",
    "Parking brake on/off both use PARKING_BRAKES toggle (sim limitation).",
    "Gear-up gate: airborne (SIM ON GROUND == 0) and VERTICAL SPEED > 0 (positive rate) — not GEAR POSITION == 1 (unreliable on Fenix custom gear)."
  ],
  "commands": [
    {
      "id": "gear_up",
      "phrases": [
        "gear up",
        "positive rate",
        "positive rate gear up",
        "positive rate gear up please",
        "positive climb",
        "positive climb gear up",
        "positive climb rate gear up",
        "gear up please"
      ],
      "response": "Checked. Gear up.",
      "reject_response": "Unable. Need positive rate and airborne for gear up.",
      "conditions": [
        { "simvar": "VERTICAL SPEED", "op": ">", "value": 0, "units": "feet per minute" },
        { "simvar": "SIM ON GROUND", "op": "==", "value": 0, "units": "bool" }
      ],
      "actions": [
        { "type": "event", "name": "GEAR_UP" },
        { "type": "set_simvar", "name": "L:S_MIP_GEAR", "value": 0, "units": "number" }
      ],
      "require_positive_climb_flag": true
    },
    {
      "id": "gear_down",
      "phrases": ["gear down", "gear down please", "landing gear down"],
      "response": "Checked. Gear down.",
      "actions": [
        { "type": "event", "name": "GEAR_DOWN" },
        { "type": "set_simvar", "name": "L:S_MIP_GEAR", "value": 1, "units": "number" }
      ]
    },
