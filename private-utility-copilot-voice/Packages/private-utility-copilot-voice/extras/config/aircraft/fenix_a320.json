{
  "profile_id": "fenix_a320",
  "title": "Fenix A320 family (events + LVars; Unable for unmapped FCU)",
  "extends": "generic",
  "notes": "Hybrid study-level profile: base_commands keep standard events; this profile dual-writes Event + Fenix LVars (Cockpit_Behavior.xml / S_* and A_* names) via set_simvar. LVar enums from community AAO/YourControls maps (S_FC_FLAPS 0–4, A_FC_SPEEDBRAKE 0=ARM/1=RETRACT/2=DETENT, S_MIP_PARKING_BRAKE 0/1, overhead S_OH_*). New overhead/system command ids are Fenix-only (merge append). Checklists fire real dual-write actions. Unmapped FCU mode holds return Unable. Live Free Flight verification recommended after Fenix updates.",
  "limitations": [
    "Select fenix_a320 via settings, GUI, or auto-detect (TITLE contains 'fenix').",
    "LVar writes use SimConnect SetDataOnSimObject (L: name). If a Fenix build ignores external LVar sets, switches may not animate; H/B-Events not bridged.",
    "Base remains event-first for generic aircraft — never put Fenix LVars in base_commands.json.",
    "Airbus FCU mode engages (HDG/ALT/SPD/VS hold, NAV, APP, LOC) are Unable; bug/var knobs best-effort events.",
    "Flaps incr/decr keep standard events only (no discrete LVar step without reading current position).",
    "APU START is a momentary LVar write (S_OH_ELEC_APU_START=1); MASTER is separate.",
    "Checklists are simplified voice sequences, not full airline SOPs.",
    "Gear-up gate: airborne (SIM ON GROUND == 0) and VERTICAL SPEED > 0 — not GEAR POSITION == 1."
  ],
  "commands": [
    {
      "id": "gear_up",
      "phrases": [
        "gear up",
        "positive rate",
        "positive rate gear up",
        "positive rate gear up please",
        "positive climb",
        "positive climb gear up",
        "positive climb rate gear up",
        "gear up please"
      ],
      "response": "Checked. Gear up.",
      "reject_response": "Unable. Need positive rate and airborne for gear up.",
      "conditions": [
        { "simvar": "VERTICAL SPEED", "op": ">", "value": 0, "units": "feet per minute" },
        { "simvar": "SIM ON GROUND", "op": "==", "value": 0, "units": "bool" }
