{
  "profile_id": "fenix_a320",
  "title": "Fenix A320 family (SimConnect events + Unable for unmapped FCU)",
  "extends": "generic",
  "notes": "Fenix-oriented profile for Private Voice Co-Pilot. Tested-in-environment: unverified in this CI/dev host (no Free Flight + Fenix). Live Free Flight with a recent Fenix A320 MSFS 2024 build is required to confirm cockpit switches. Core gear/flaps/parking-brake/AP/external-light commands use standard SimConnect client events that Fenix typically honors for hardware. True LVar / H-Event / B-Event bridges are NOT supported by this host action pipeline — unmapped FCU modes and custom systems return a clear Unable TTS instead of a silent no-op.",
  "limitations": [
    "No automatic aircraft detection — select fenix_a320 via settings.json aircraft_profile or GUI Settings → Apply/Save/Reload.",
    "Host can only TransmitEvent / local SetSimVar; Fenix-only LVars and H/B-Events cannot be written through this pipeline.",
    "Airbus FCU mode engages (HDG/ALT/SPD/VS hold, NAV, APP, LOC) are overridden to Unable — they do not map cleanly to Boeing-style SimConnect mode events on Fenix.",
    "FCU bug/var knobs (heading/alt/spd/vs inc/dec) keep standard events best-effort; cockpit effect depends on Fenix build.",
    "Anti-ice, APU, cabin/wing/logo lights, and complex overhead remain base mappings or may need future LVar support.",
    "Taxi light on/off both use TOGGLE_TAXI_LIGHTS (sim limitation).",
    "Parking brake on/off both use PARKING_BRAKES toggle (sim limitation)."
  ],
  "commands": [
    {
      "id": "gear_up",
      "phrases": [
        "gear up",
        "positive climb gear up",
        "positive climb rate gear up",
        "gear up please"
      ],
      "response": "Checked. Gear up.",
      "reject_response": "Unable. Conditions not met for gear up.",
      "conditions": [
        { "simvar": "VERTICAL SPEED", "op": ">", "value": 100, "units": "feet per minute" },
        { "simvar": "GEAR POSITION", "op": "==", "value": 1, "units": "percent over 100" }
      ],
      "actions": [
        { "type": "event", "name": "GEAR_UP" }
      ],
      "require_positive_climb_flag": true
    },
