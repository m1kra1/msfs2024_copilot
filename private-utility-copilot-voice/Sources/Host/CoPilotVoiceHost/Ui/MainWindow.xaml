<Window x:Class="CoPilotVoiceHost.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoPilot Voice Host – Offline"
        Height="680" Width="960"
        MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
  <DockPanel>
    <!-- Status bar -->
    <StatusBar x:Name="BottomBar" DockPanel.Dock="Bottom" MinHeight="32">
      <StatusBarItem>
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="ConnDot" Width="11" Height="11" Fill="{StaticResource BadBrush}" Margin="0,0,10,0"/>
          <TextBlock x:Name="StatusBarText" Text="Disconnected · Offline"/>
        </StackPanel>
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock x:Name="StatusBarVersion" Text="" Foreground="{StaticResource MutedBrush}"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="16,14,16,10">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel Grid.Row="0" Margin="0,0,0,12">
        <CheckBox x:Name="AlwaysOnTopCheck"
                  Content="Always on Top"
                  Checked="AlwaysOnTop_Changed"
                  Unchecked="AlwaysOnTop_Changed"
                  VerticalAlignment="Center"/>
        <TextBlock DockPanel.Dock="Right"
                   x:Name="HeaderMode"
                   Text="Mode: Offline"
                   Style="{StaticResource LabelMuted}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Center"
                   FontWeight="SemiBold"/>
      </DockPanel>

      <TabControl Grid.Row="1">
        <!-- STATUS -->
        <TabItem Header="Status">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel>
              <GroupBox Header="SIMCONNECT">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Connection" Style="{StaticResource LabelMuted}" Grid.Row="0" Margin="0,4"/>
                  <TextBlock x:Name="TxtConnected" Text="—" Grid.Row="0" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"/>
                  <TextBlock Text="IsLive" Style="{StaticResource LabelMuted}" Grid.Row="1" Margin="0,4"/>
                  <TextBlock x:Name="TxtLive" Text="—" Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"/>
                  <TextBlock Text="Status message" Style="{StaticResource LabelMuted}" Grid.Row="2" Margin="0,4"/>
                  <TextBlock x:Name="TxtSimMessage" Text="—" Grid.Row="2" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
                  <TextBlock Text="Last error" Style="{StaticResource LabelMuted}" Grid.Row="3" Margin="0,4"/>
                  <TextBlock x:Name="TxtSimError" Text="—" Grid.Row="3" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" Foreground="{StaticResource BadBrush}"/>
                </Grid>
              </GroupBox>
              <GroupBox Header="FLIGHT DATA">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Aircraft" Style="{StaticResource LabelMuted}" Grid.Row="0" Margin="0,4"/>
                  <TextBlock x:Name="TxtDetectedAircraft" Text="Unknown" Grid.Row="0" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" FontWeight="SemiBold"/>
                  <TextBlock Text="Airport" Style="{StaticResource LabelMuted}" Grid.Row="1" Margin="0,4"/>
                  <TextBlock x:Name="TxtAirport" Text="—" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                  <TextBlock Text="Altitude" Style="{StaticResource LabelMuted}" Grid.Row="2" Margin="0,4"/>
                  <TextBlock x:Name="TxtAltitude" Text="—" Grid.Row="2" Grid.Column="1" Margin="0,4"/>
                  <TextBlock Text="Speed (IAS)" Style="{StaticResource LabelMuted}" Grid.Row="3" Margin="0,4"/>
                  <TextBlock x:Name="TxtAirspeed" Text="—" Grid.Row="3" Grid.Column="1" Margin="0,4"/>
                  <TextBlock Text="Vertical speed" Style="{StaticResource LabelMuted}" Grid.Row="4" Margin="0,4"/>
                  <TextBlock x:Name="TxtVerticalSpeed" Text="—" Grid.Row="4" Grid.Column="1" Margin="0,4"/>
                  <TextBlock Text="On ground" Style="{StaticResource LabelMuted}" Grid.Row="5" Margin="0,4"/>
                  <TextBlock x:Name="TxtOnGround" Text="—" Grid.Row="5" Grid.Column="1" Margin="0,4"/>
                  <TextBlock Text="Sim data" Style="{StaticResource LabelMuted}" Grid.Row="6" Margin="0,4"/>
                  <TextBlock x:Name="TxtSimData" Text="Waiting…" Grid.Row="6" Grid.Column="1" Margin="0,4"/>
                  <TextBlock Text="Aircraft profile" Style="{StaticResource LabelMuted}" Grid.Row="7" Margin="0,4"/>
                  <TextBlock x:Name="TxtProfile" Text="—" Grid.Row="7" Grid.Column="1" Margin="0,4"/>
                </Grid>
              </GroupBox>
              <GroupBox Header="VOICE">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Last phrase" Style="{StaticResource LabelMuted}" Grid.Row="0" Margin="0,4"/>
                  <TextBlock x:Name="TxtLastPhrase" Text="—" Grid.Row="0" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
                  <TextBlock Text="Confidence" Style="{StaticResource LabelMuted}" Grid.Row="1" Margin="0,4"/>
                  <TextBlock x:Name="TxtConfidence" Text="—" Grid.Row="1" Grid.Column="1" Margin="0,4"/>
                  <TextBlock Text="Last action" Style="{StaticResource LabelMuted}" Grid.Row="2" Margin="0,4"/>
                  <TextBlock x:Name="TxtLastAction" Text="—" Grid.Row="2" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
                  <TextBlock Text="Microphone" Style="{StaticResource LabelMuted}" Grid.Row="3" Margin="0,4"/>
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                    <Ellipse x:Name="MicDot" Width="14" Height="14" Fill="{StaticResource BorderBrushKey}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtMic" Text="Idle"/>
                  </StackPanel>
                </Grid>
              </GroupBox>
              <GroupBox Header="VERSIONS">
                <TextBlock x:Name="TxtVersions" Text="—" Margin="0,2"/>
              </GroupBox>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- SETTINGS -->
        <TabItem Header="Settings">
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel>
              <GroupBox Header="SPEECH">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Wake word" Style="{StaticResource LabelMuted}" Grid.Row="0" VerticalAlignment="Center"/>
                  <TextBox x:Name="SetWakeWord" Grid.Row="0" Grid.Column="1" Margin="0,5"/>
                  <TextBlock Text="PTT key" Style="{StaticResource LabelMuted}" Grid.Row="1" VerticalAlignment="Center"/>
                  <TextBox x:Name="SetPttKey" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
                  <TextBlock Text="Confidence (0–1)" Style="{StaticResource LabelMuted}" Grid.Row="2" VerticalAlignment="Center"/>
                  <TextBox x:Name="SetConfidence" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
                  <TextBlock Text="PTT grace ms" Style="{StaticResource LabelMuted}" Grid.Row="3" VerticalAlignment="Center"/>
                  <TextBox x:Name="SetPttGrace" Grid.Row="3" Grid.Column="1" Margin="0,5"/>
                  <CheckBox x:Name="SetContinuous" Content="Continuous listen" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                </Grid>
              </GroupBox>
              <GroupBox Header="TTS / BEHAVIOR / PROFILE">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="TTS engine" Style="{StaticResource LabelMuted}" Grid.Row="0" VerticalAlignment="Center"/>
                  <ComboBox x:Name="SetTtsEngine"
                            Grid.Row="0" Grid.Column="1"
                            Margin="0,5"
                            MaxDropDownHeight="200"
                            ToolTip="Windows = SAPI only; Wav = pre-recorded pack only; Hybrid = WAV then Windows fallback"/>
                  <TextBlock Text="Voice pack" Style="{StaticResource LabelMuted}" Grid.Row="1" VerticalAlignment="Center"/>
                  <ComboBox x:Name="SetTtsVoicePack"
                            Grid.Row="1" Grid.Column="1"
                            Margin="0,5"
                            IsEditable="True"
                            MaxDropDownHeight="240"
                            ToolTip="Folder under extras/voices/ with manifest.json"/>
                  <TextBlock Text="TTS voice (Windows)" Style="{StaticResource LabelMuted}" Grid.Row="2" VerticalAlignment="Center"/>
                  <TextBox x:Name="SetTtsVoice" Grid.Row="2" Grid.Column="1" Margin="0,5"
                           ToolTip="Windows SAPI voice name (used by Windows and Hybrid fallback)"/>
                  <TextBlock Text="WAV callouts need matching files under extras/voices/. Hybrid falls back to Windows TTS. Sample packs: Austrian Airlines &amp; Lufthansa."
                             Style="{StaticResource LabelMuted}" Grid.Row="3" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,4,0,4"/>
                  <CheckBox x:Name="SetPositiveClimb" Content="Require positive climb for gear up" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,6,0,0"/>
                  <TextBlock Text="Aircraft profile" Style="{StaticResource LabelMuted}" Grid.Row="5" VerticalAlignment="Center"/>
                  <!-- Full ComboBox template from theme; editable text stays high-contrast -->
                  <ComboBox x:Name="SetProfile"
                            Grid.Row="5" Grid.Column="1"
                            Margin="0,5"
                            IsEditable="True"
                            MaxDropDownHeight="320"
                            ToolTip="Select aircraft command profile (manual; auto-detect can override when enabled)"/>
                  <CheckBox x:Name="SetAutoDetect"
                            Content="Auto-detect aircraft profile from SimConnect (TITLE / ATC MODEL)"
                            Grid.Row="6" Grid.ColumnSpan="2" Margin="0,10,0,0"
                            ToolTip="When Live and enabled, switches profile via config/aircraft_detection.json. CLI --profile locks auto switch."/>
                  <CheckBox x:Name="SetAnnounceProfile"
                            Content="Announce profile switch (TTS)"
                            Grid.Row="7" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                </Grid>
              </GroupBox>
              <WrapPanel Margin="0,4,0,0">
                <Button Content="Apply" Click="BtnApply_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="Save" Click="BtnSave_Click"/>
                <Button Content="Reload" Click="BtnReload_Click"/>
                <Button Content="Open Config Folder" Click="BtnOpenConfig_Click"/>
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- MANUAL TRIGGER -->
        <TabItem Header="Manual" GotFocus="ManualTab_GotFocus">
          <Grid Margin="12,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,10">
              <Button DockPanel.Dock="Right" Content="Refresh" Click="BtnManualRefresh_Click"
                      ToolTip="Rebuild buttons from the currently loaded catalog"/>
              <StackPanel>
                <TextBlock Text="Manual commands"
                           FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock x:Name="ManualHint"
                           Style="{StaticResource LabelMuted}"
                           TextWrapping="Wrap"
                           Text="Fire any loaded command for the active aircraft profile (bypasses wake word / PTT). Conditions still apply."/>
              </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,4,0">
              <StackPanel x:Name="ManualPanel"/>
            </ScrollViewer>
            <TextBlock Grid.Row="2" x:Name="ManualStatus" Style="{StaticResource LabelMuted}"
                       Margin="0,10,0,0" TextWrapping="Wrap" Text=""/>
          </Grid>
        </TabItem>

        <!-- CHECKLISTS -->
        <TabItem Header="Checklists" GotFocus="ChecklistsTab_GotFocus">
          <Grid Margin="12,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="280"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Left: list -->
            <GroupBox Header="CHECKLISTS" Grid.Column="0" Grid.Row="0">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                  <TextBlock Text="Filter" Style="{StaticResource LabelMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="ClFilterProfile" MinHeight="32" SelectionChanged="ClFilter_Changed"/>
                </DockPanel>
                <TextBox x:Name="ClSearch" Grid.Row="1" MinHeight="32" Margin="0,0,0,8"
                         VerticalContentAlignment="Center" TextChanged="ClFilter_Changed"
                         ToolTip="Filter by name or id"/>
                <ListBox x:Name="ClList" Grid.Row="2"
                         DisplayMemberPath="Display"
                         SelectionChanged="ClList_SelectionChanged"/>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="New" Click="BtnClNew_Click" MinWidth="72" Margin="0,0,8,0"/>
                  <Button Content="Delete" Click="BtnClDelete_Click" MinWidth="72"/>
                </StackPanel>
              </Grid>
            </GroupBox>

            <!-- Right: run + editor -->
            <ScrollViewer Grid.Column="2" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
              <StackPanel>
                <GroupBox Header="RUN">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <Button DockPanel.Dock="Right" Content="Stop" Click="BtnClStop_Click" MinWidth="80" Margin="8,0,0,0"/>
                      <Button DockPanel.Dock="Right" Content="Start" Click="BtnClStart_Click" MinWidth="80"/>
                      <TextBlock x:Name="ClProgressText" Text="Idle" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock x:Name="ClChallengeText" Style="{StaticResource LabelMuted}" TextWrapping="Wrap" Text=""/>
                  </StackPanel>
                </GroupBox>

                <GroupBox Header="EDITOR" Margin="0,10,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Id" Style="{StaticResource LabelMuted}" Grid.Row="0" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClEditId" Grid.Row="0" Grid.Column="1" MinHeight="32" Margin="0,0,8,6"
                             TextChanged="ClEditor_Changed"/>
                    <TextBlock Text="Name" Style="{StaticResource LabelMuted}" Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClEditName" Grid.Row="0" Grid.Column="3" MinHeight="32" Margin="0,0,0,6"
                             TextChanged="ClEditor_Changed"/>

                    <TextBlock Text="Phrases" Style="{StaticResource LabelMuted}" Grid.Row="1" Margin="0,0,8,6"/>
                    <TextBox x:Name="ClEditPhrases" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                             MinHeight="56" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,6" TextChanged="ClEditor_Changed"
                             ToolTip="One phrase per line; each must contain the word checklist"/>

                    <TextBlock Text="Global delay ms" Style="{StaticResource LabelMuted}" Grid.Row="2" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClEditGlobalDelay" Grid.Row="2" Grid.Column="1" MinHeight="32" Margin="0,0,8,6"
                             TextChanged="ClEditor_Changed"/>
                    <TextBlock Text="Profiles" Style="{StaticResource LabelMuted}" Grid.Row="2" Grid.Column="2" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClEditProfiles" Grid.Row="2" Grid.Column="3" MinHeight="32" Margin="0,0,0,6"
                             TextChanged="ClEditor_Changed"
                             ToolTip="Comma-separated profile ids; empty = all profiles"/>

                    <TextBlock Text="Items" Style="{StaticResource LabelMuted}" Grid.Row="3" Margin="0,4,8,6"/>
                    <ListBox x:Name="ClItemsList" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                             MinHeight="120" Margin="0,0,0,6"
                             DisplayMemberPath="Display"
                             SelectionChanged="ClItemsList_SelectionChanged"/>

                    <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,8">
                      <Button Content="Add item" Click="BtnClItemAdd_Click" MinWidth="88" Margin="0,0,8,0"/>
                      <Button Content="Remove" Click="BtnClItemRemove_Click" MinWidth="80" Margin="0,0,8,0"/>
                      <Button Content="Up" Click="BtnClItemUp_Click" MinWidth="56" Margin="0,0,8,0"/>
                      <Button Content="Down" Click="BtnClItemDown_Click" MinWidth="56"/>
                    </StackPanel>

                    <TextBlock Text="Mode" Style="{StaticResource LabelMuted}" Grid.Row="5" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ClItemMode" Grid.Row="5" Grid.Column="1" MinHeight="32" Margin="0,0,8,6"
                              SelectionChanged="ClItemEditor_Changed">
                      <ComboBoxItem Content="verify"/>
                      <ComboBoxItem Content="execute"/>
                    </ComboBox>
                    <TextBlock Text="Challenge" Style="{StaticResource LabelMuted}" Grid.Row="5" Grid.Column="2" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClItemChallenge" Grid.Row="5" Grid.Column="3" MinHeight="32" Margin="0,0,0,6"
                             TextChanged="ClItemEditor_Changed"/>

                    <TextBlock Text="Command id" Style="{StaticResource LabelMuted}" Grid.Row="6" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ClItemCommandId" Grid.Row="6" Grid.Column="1" MinHeight="32" Margin="0,0,8,6"
                              IsEditable="True" SelectionChanged="ClItemEditor_Changed"
                              LostFocus="ClItemEditor_LostFocus"/>
                    <TextBlock Text="Delay after ms" Style="{StaticResource LabelMuted}" Grid.Row="6" Grid.Column="2" Margin="0,0,8,6" VerticalAlignment="Center"/>
                    <TextBox x:Name="ClItemDelayAfter" Grid.Row="6" Grid.Column="3" MinHeight="32" Margin="0,0,0,6"
                             TextChanged="ClItemEditor_Changed"/>

                    <TextBlock Text="Action JSON" Style="{StaticResource LabelMuted}" Grid.Row="7" Margin="0,0,8,6"/>
                    <TextBox x:Name="ClItemAction" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3"
                             MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,6"
                             TextChanged="ClItemEditor_Changed"
                             ToolTip="Optional free action: type|name|value|units per line (same as Commands tab)"/>

                    <TextBlock Text="Expected" Style="{StaticResource LabelMuted}" Grid.Row="8" Margin="0,0,8,6"/>
                    <TextBox x:Name="ClItemExpected" Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="3"
                             MinHeight="48" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,6"
                             TextChanged="ClItemEditor_Changed"
                             ToolTip="Verify condition lines: simvar|op|value|units"/>
                  </Grid>
                </GroupBox>
              </StackPanel>
            </ScrollViewer>

            <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10,0,0">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="Apply" Click="BtnClApply_Click" MinWidth="88" Margin="0,0,8,0"
                        ToolTip="Apply checklists in memory"/>
                <Button Content="Save" Click="BtnClSave_Click" MinWidth="88" Margin="0,0,8,0"
                        ToolTip="Apply and write config/checklists/*.json"/>
                <Button Content="Reload" Click="BtnClReload_Click" MinWidth="88"
                        ToolTip="Reload checklists from disk into the editor"/>
              </StackPanel>
              <TextBlock x:Name="ClStatus" Style="{StaticResource LabelMuted}" VerticalAlignment="Center"
                         TextWrapping="Wrap" Margin="12,0,0,0"/>
            </DockPanel>
          </Grid>
        </TabItem>

        <!-- LEARN MODE -->
        <TabItem Header="Learn" GotFocus="LearnTab_GotFocus">
          <Grid Margin="12,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#2A3340" BorderBrush="#4A5568" BorderThickness="1"
                    CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource FgBrush}" FontSize="12"
                         Text="Learn Mode detects value changes on watched SimVars/LVars. Unknown study switches need a catalog entry, profile watchlist, or a manual watch name."/>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,0,0,8">
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <CheckBox x:Name="LearnActiveCheck" Content="Learn Mode active"
                          VerticalAlignment="Center" Checked="LearnActive_Changed" Unchecked="LearnActive_Changed"/>
                <TextBlock x:Name="LearnMeta" Style="{StaticResource LabelMuted}"
                           VerticalAlignment="Center" Margin="16,0,0,0"
                           Text="Watches: 0 · Profile: — · Live: No"/>
              </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="2" Margin="0,0,0,8">
              <TextBlock DockPanel.Dock="Left" Text="Manual watch" Style="{StaticResource LabelMuted}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Button DockPanel.Dock="Right" Content="Add" Click="BtnLearnAddWatch_Click" MinWidth="72" Margin="8,0,0,0"/>
              <ComboBox x:Name="LearnWatchUnits" Width="100" Margin="8,0,0,0" DockPanel.Dock="Right"
                        VerticalAlignment="Center" IsEditable="True" Text="number">
                <ComboBoxItem Content="number" IsSelected="True"/>
                <ComboBoxItem Content="bool"/>
                <ComboBoxItem Content="percent"/>
              </ComboBox>
              <TextBox x:Name="LearnWatchName" MinHeight="32" VerticalContentAlignment="Center"
                       ToolTip="e.g. L:S_MIP_GEAR or LIGHT LANDING"/>
            </DockPanel>

            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <DockPanel Grid.Column="0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Export JSON" Click="BtnLearnExport_Click" MinWidth="96" Margin="0,0,8,0"
                            ToolTip="Write recent detections to learn-detections-*.json next to the EXE"/>
                    <Button Content="Clear list" Click="BtnLearnClear_Click" MinWidth="80"/>
                  </StackPanel>
                  <CheckBox x:Name="LearnOnlyUnmapped" Content="Only unmapped" VerticalAlignment="Center"
                            Checked="LearnFilter_Changed" Unchecked="LearnFilter_Changed"/>
                </DockPanel>
                <ListView x:Name="LearnList"
                          SelectionChanged="LearnList_SelectionChanged"
                          BorderThickness="1"
                          Background="{StaticResource InputBrush}"
                          Foreground="{StaticResource FgBrush}"
                          TextElement.Foreground="{StaticResource FgBrush}">
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Time" Width="72" DisplayMemberBinding="{Binding TimeText}"/>
                      <GridViewColumn Header="Signal" Width="160" DisplayMemberBinding="{Binding SignalName}"/>
                      <GridViewColumn Header="Change" Width="90" DisplayMemberBinding="{Binding ChangeText}"/>
                      <GridViewColumn Header="Status" Width="90" DisplayMemberBinding="{Binding StatusText}"/>
                      <GridViewColumn Header="Mapped" Width="140" DisplayMemberBinding="{Binding MappedText}"/>
                    </GridView>
                  </ListView.View>
                </ListView>
              </DockPanel>

              <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <TextBlock Text="Detail" FontWeight="SemiBold" Margin="0,0,0,6"/>
                  <TextBlock x:Name="LearnDetail" Style="{StaticResource LabelMuted}" TextWrapping="Wrap"
                             Text="Select a detection."/>
                  <WrapPanel Margin="0,10,0,0">
                    <Button Content="Create Command" Click="BtnLearnCreate_Click" MinWidth="120" Margin="0,0,8,6"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="BtnLearnEdit" Content="Edit Mapped" Click="BtnLearnEdit_Click" MinWidth="100" Margin="0,0,8,6"
                            IsEnabled="False"/>
                    <Button Content="Copy name" Click="BtnLearnCopyName_Click" MinWidth="90" Margin="0,0,0,6"/>
                  </WrapPanel>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <GroupBox Grid.Row="4" Header="Create / Edit command (active profile)" Margin="0,10,0,0" Padding="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Id" Style="{StaticResource LabelMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="LearnEditId" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                         MinHeight="32" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Phrases" Style="{StaticResource LabelMuted}"
                           VerticalAlignment="Top" Margin="0,4,8,6"/>
                <TextBox x:Name="LearnEditPhrases" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         MinHeight="56" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,6"
                         ToolTip="One phrase per line"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Response" Style="{StaticResource LabelMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="LearnEditResponse" Grid.Row="2" Grid.Column="1" MinHeight="32" Margin="0,0,8,6"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Reject" Style="{StaticResource LabelMuted}"
                           VerticalAlignment="Center" Margin="0,0,8,6"/>
                <TextBox x:Name="LearnEditReject" Grid.Row="2" Grid.Column="3" MinHeight="32" Margin="0,0,0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Actions" Style="{StaticResource LabelMuted}"
                           VerticalAlignment="Top" Margin="0,4,8,6"/>
                <TextBox x:Name="LearnEditActions" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3"
                         MinHeight="40" IsReadOnly="True" Margin="0,0,0,6"
                         Background="#1A2028" Foreground="{StaticResource FgBrush}"/>

                <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,4,0,0">
                  <Button Content="Save to active profile" Click="BtnLearnSave_Click"
                          Style="{StaticResource PrimaryButton}" MinWidth="160" Margin="0,0,8,0"/>
                  <Button Content="Cancel" Click="BtnLearnCancelEdit_Click" MinWidth="80"/>
                  <TextBlock x:Name="LearnEditStatus" Style="{StaticResource LabelMuted}"
                             VerticalAlignment="Center" Margin="12,0,0,0" Text=""/>
                </WrapPanel>
              </Grid>
            </GroupBox>

            <TextBlock Grid.Row="5" x:Name="LearnStatus" Style="{StaticResource LabelMuted}"
                       Margin="0,8,0,0" TextWrapping="Wrap" Text=""/>
          </Grid>
        </TabItem>

        <!-- COMMANDS -->
        <TabItem Header="Commands" GotFocus="CommandsTab_GotFocus">
          <Grid Margin="12,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
              <WrapPanel DockPanel.Dock="Right">
                <Button Content="Reload" Click="BtnCmdReload_Click" ToolTip="Reload base + active profile from disk into editor"/>
                <Button Content="Apply" Click="BtnCmdApply_Click" ToolTip="Apply editor to live catalog (memory only)"/>
                <Button Content="Save" Click="BtnCmdSave_Click" Style="{StaticResource PrimaryButton}"
                        ToolTip="Save base_commands.json + active aircraft profile and apply"/>
              </WrapPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filter" Style="{StaticResource LabelMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="CmdFilter" Width="200" MinHeight="32" Margin="0,0,12,0" TextChanged="CmdFilter_TextChanged"/>
                <TextBlock x:Name="CmdStatus" Style="{StaticResource LabelMuted}" VerticalAlignment="Center" Text=""/>
              </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1.2*"/>
              </Grid.ColumnDefinitions>

              <!-- List -->
              <DockPanel Grid.Column="0">
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                  <Button Content="Add" Click="BtnCmdAdd_Click" MinWidth="72"/>
                  <ComboBox x:Name="CmdAddTarget" Width="140" Margin="6,0,0,0" VerticalAlignment="Center"
                            ToolTip="Where new commands are stored">
                    <ComboBoxItem Content="base" IsSelected="True"/>
                    <ComboBoxItem Content="active profile"/>
                  </ComboBox>
                  <Button Content="Delete" Click="BtnCmdDelete_Click" MinWidth="72" Margin="8,0,0,0"/>
                </WrapPanel>
                <ListView x:Name="CmdList"
                          SelectionChanged="CmdList_SelectionChanged"
                          BorderThickness="1"
                          Background="{StaticResource InputBrush}"
                          Foreground="{StaticResource FgBrush}"
                          TextElement.Foreground="{StaticResource FgBrush}">
                  <ListView.Resources>
                    <!-- GridView DisplayMemberBinding cells as TextBlock — force readable light text -->
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource FgBrush}"/>
                      <Setter Property="FontSize" Value="13.5"/>
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                  </ListView.Resources>
                  <ListView.View>
                    <GridView>
                      <GridViewColumn Header="Id" Width="150" DisplayMemberBinding="{Binding Id}"/>
                      <GridViewColumn Header="Source" Width="90" DisplayMemberBinding="{Binding Source}"/>
                      <GridViewColumn Header="Phrases" Width="220" DisplayMemberBinding="{Binding PhrasesPreview}"/>
                    </GridView>
                  </ListView.View>
                </ListView>
              </DockPanel>

              <!-- Editor -->
              <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <GroupBox Header="COMMAND">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="Id" Style="{StaticResource LabelMuted}" VerticalAlignment="Center" Margin="0,4"/>
                      <TextBox x:Name="CmdEditId" Grid.Column="1" Margin="0,4"/>
                      <TextBlock Text="Source" Style="{StaticResource LabelMuted}" Grid.Row="1" VerticalAlignment="Center" Margin="0,4"/>
                      <TextBlock x:Name="CmdEditSource" Grid.Row="1" Grid.Column="1" Margin="0,4" FontWeight="SemiBold"/>
                      <TextBlock Text="Response (TTS)" Style="{StaticResource LabelMuted}" Grid.Row="2" VerticalAlignment="Center" Margin="0,4"/>
                      <TextBox x:Name="CmdEditResponse" Grid.Row="2" Grid.Column="1" Margin="0,4" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="48"/>
                      <TextBlock Text="Reject TTS" Style="{StaticResource LabelMuted}" Grid.Row="3" VerticalAlignment="Center" Margin="0,4"/>
                      <TextBox x:Name="CmdEditReject" Grid.Row="3" Grid.Column="1" Margin="0,4" TextWrapping="Wrap"/>
                      <CheckBox x:Name="CmdEditClimb" Content="require_positive_climb_flag" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0"/>
                      <CheckBox x:Name="CmdEditChecklist" Content="checklist" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,0"/>
                    </Grid>
                  </GroupBox>
                  <GroupBox Header="PHRASES (one per line)">
                    <TextBox x:Name="CmdEditPhrases" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                  </GroupBox>
                  <GroupBox Header="ACTIONS (one per line: EVENT_NAME or type|name)">
                    <TextBox x:Name="CmdEditActions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                  </GroupBox>
                  <GroupBox Header="CONDITIONS (one per line: SIMVAR | op | value | units)">
                    <TextBox x:Name="CmdEditConditions" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70"
                             VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                  </GroupBox>
                  <TextBlock Style="{StaticResource LabelMuted}" TextWrapping="Wrap" Margin="0,4,0,0"
                             Text="Apply = live catalog only. Save = write base_commands.json and the active aircraft profile, then apply. Profile overrides base when ids match."/>
                </StackPanel>
              </ScrollViewer>
            </Grid>

            <TextBlock Grid.Row="2" x:Name="CmdHint" Style="{StaticResource LabelMuted}" Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Text="Showing merged catalog (base + active profile). Edit fields, then Apply or Save."/>
          </Grid>
        </TabItem>

        <!-- DEBUG -->
        <TabItem Header="Debug">
          <Grid Margin="12,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <WrapPanel Grid.Row="0" Margin="0,0,0,10">
              <Button Content="Force Reconnect" Click="BtnReconnect_Click"/>
              <Button Content="Clear Logs" Click="BtnClearLogs_Click"/>
              <Button Content="Test TTS" Click="BtnTestTts_Click"/>
              <Button Content="Reload Config &amp; Profiles" Click="BtnReloadAll_Click"/>
              <CheckBox x:Name="DbgContinuous"
                        Content="Continuous listen (live)"
                        VerticalAlignment="Center"
                        Margin="8,0,0,8"
                        Checked="DbgContinuous_Changed"
                        Unchecked="DbgContinuous_Changed"/>
            </WrapPanel>
            <TextBox x:Name="LogView"
                     Grid.Row="1"
                     Style="{StaticResource LogTextBox}"
                     IsReadOnly="True"
                     AcceptsReturn="True"/>
            <DockPanel Grid.Row="2" Margin="0,12,0,0">
              <Button DockPanel.Dock="Right"
                      Content="Inject"
                      Click="BtnInject_Click"
                      MinWidth="100"
                      Style="{StaticResource PrimaryButton}"
                      Margin="0,0,0,0"/>
              <CheckBox x:Name="InjectForce"
                        Content="Force (bypass gate)"
                        DockPanel.Dock="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"/>
              <TextBox x:Name="InjectBox" Margin="0,0,10,0" MinHeight="36"/>
            </DockPanel>
          </Grid>
        </TabItem>
      </TabControl>
    </Grid>
  </DockPanel>
</Window>
