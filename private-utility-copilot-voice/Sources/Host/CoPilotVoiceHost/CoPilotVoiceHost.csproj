<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CoPilotVoiceHost</RootNamespace>
    <AssemblyName>CoPilotVoiceHost</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon />
    <StartupObject>CoPilotVoiceHost.Program</StartupObject>
    <Version>1.7.0</Version>
    <AssemblyVersion>1.7.0.0</AssemblyVersion>
    <FileVersion>1.7.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.10" />
  </ItemGroup>

  <!-- Copy default config + voice packs + SimConnect client stack next to the EXE -->
  <ItemGroup>
    <None Include="..\..\..\PackageSources\extras\config\**\*.json" Link="config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\PackageSources\extras\voices\**\*.*" Link="voices\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\PackageSources\extras\SimConnect.dll" Link="SimConnect.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\PackageSources\extras\SimConnect.dll')" />
    <None Include="..\..\..\PackageSources\extras\SimConnect.cfg" Link="SimConnect.cfg" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\PackageSources\extras\SimConnect.cfg')" />
    <None Include="..\..\..\PackageSources\extras\Microsoft.FlightSimulator.SimConnect.dll" Link="Microsoft.FlightSimulator.SimConnect.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\PackageSources\extras\Microsoft.FlightSimulator.SimConnect.dll')" />
  </ItemGroup>

</Project>
