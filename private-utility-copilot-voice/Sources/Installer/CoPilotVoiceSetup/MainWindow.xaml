<Window x:Class="CoPilotVoiceSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Voice Co-Pilot Setup"
        Height="520" Width="640"
        MinHeight="480" MinWidth="560"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BtnBack" Content="Back" Click="BtnBack_Click" IsEnabled="False"/>
      <Button x:Name="BtnNext" Content="Next" Style="{StaticResource PrimaryButton}" Click="BtnNext_Click"/>
      <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" Text="Private Voice Co-Pilot Setup" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock x:Name="SubtitleText" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
    </StackPanel>

    <!-- Pages -->
    <Grid>
      <!-- Welcome -->
      <StackPanel x:Name="PageWelcome" Visibility="Visible">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="This setup copies the Co-Pilot Community package and creates shortcuts to start the out-of-process host."/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"
                   Text="MSFS does not auto-start the host. After install: start Free Flight, then use the Desktop or Start Menu shortcut."/>
        <TextBlock x:Name="WelcomeVersion" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <TextBlock x:Name="WelcomePayload" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
        <Button x:Name="BtnGoUninstall" Content="Uninstall existing installation…" HorizontalAlignment="Left"
                Margin="0,20,0,0" Click="BtnGoUninstall_Click" Visibility="Collapsed"/>
      </StackPanel>

      <!-- Runtime -->
      <StackPanel x:Name="PageRuntime" Visibility="Collapsed">
        <TextBlock Text="Microsoft .NET 8 Desktop Runtime is required to run CoPilotVoiceHost.exe (framework-dependent)."
                   TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Border Padding="12" Background="{StaticResource PanelBrush}" CornerRadius="4" Margin="0,0,0,12">
          <StackPanel>
            <TextBlock x:Name="RuntimeStatus" FontWeight="SemiBold"/>
            <TextBlock x:Name="RuntimeHint" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <Button Content="Open .NET 8 download page" HorizontalAlignment="Left" Click="BtnDownloadDotNet_Click"/>
        <TextBlock Text="You can still install files if the runtime is missing; launching the host will fail until it is installed."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
      </StackPanel>

      <!-- Location -->
      <StackPanel x:Name="PageLocation" Visibility="Collapsed">
        <TextBlock Text="MSFS 2024 Community folder" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <ComboBox x:Name="CommunityCombo" IsEditable="True" Grid.Column="0" Height="32"/>
          <Button Content="Browse…" Grid.Column="1" Click="BtnBrowse_Click"/>
          <Button Content="Detect" Grid.Column="2" Click="BtnDetect_Click"/>
        </Grid>
        <TextBlock x:Name="LocationStatus" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0"
                   Text="Package will be installed as: Community\private-utility-copilot-voice\"/>
      </StackPanel>

      <!-- Options -->
      <StackPanel x:Name="PageOptions" Visibility="Collapsed">
        <CheckBox x:Name="OptDesktop" Content="Create Desktop shortcut" IsChecked="True"/>
        <CheckBox x:Name="OptStartMenu" Content="Create Start Menu shortcut (+ Uninstall entry)" IsChecked="True"/>
        <CheckBox x:Name="OptKeepConfig" Content="Keep my config on upgrade (settings + aircraft profiles)" IsChecked="True"/>
        <CheckBox x:Name="OptLaunch" Content="Launch host when finished"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"
                   Text="On upgrade, base_commands and voice packs are refreshed from the package. A config backup is always written under %LocalAppData%\PrivateCoPilotVoice\backup\."/>
      </StackPanel>

      <!-- Progress -->
      <StackPanel x:Name="PageProgress" Visibility="Collapsed">
        <TextBlock x:Name="ProgressTitle" Text="Working…" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBox x:Name="ProgressLog" IsReadOnly="True" Height="220" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
      </StackPanel>

      <!-- Finish -->
      <StackPanel x:Name="PageFinish" Visibility="Collapsed">
        <TextBlock x:Name="FinishMessage" TextWrapping="Wrap" FontSize="15" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="BtnLaunchHost" Content="Launch Host" Style="{StaticResource PrimaryButton}" Click="BtnLaunchHost_Click"/>
          <Button Content="Open package folder" Click="BtnOpenFolder_Click"/>
        </StackPanel>
      </StackPanel>

      <!-- Uninstall confirm -->
      <StackPanel x:Name="PageUninstall" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="This removes the Community package folder private-utility-copilot-voice, Desktop/Start Menu shortcuts, and install metadata."/>
        <TextBlock x:Name="UninstallTarget" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                   Text="A backup of extras\config will be saved under LocalAppData before deletion."/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
